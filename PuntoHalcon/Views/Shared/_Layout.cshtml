<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#073f3d"/><title>@ViewData["Title"] - Portal de Evidencias</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
@if(User.Identity?.IsAuthenticated==true){<header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>SKILL<span class="brand-light">FILE</span></span></a><nav><a asp-controller="Home" asp-action="Index">Inicio</a><a asp-controller="Home" asp-action="Perfil">Perfil</a><a asp-controller="Home" asp-action="FormacionAcademica">Formación académica</a><a asp-controller="Home" asp-action="FormacionExtra">Formación extra</a><a asp-controller="Home" asp-action="Proyectos">Proyectos</a><a asp-controller="Home" asp-action="Evidencias">Evidencias</a></nav><form asp-controller="Acceso" asp-action="Salir" method="post"><button class="logout">Cerrar sesión</button></form></header>}
<main class="page">@RenderBody()</main><footer>SKILL FILE · Portal de evidencias académicas</footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
