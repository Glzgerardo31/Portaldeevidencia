@model string
@{var items=ViewBag.Items as List<Dominio.Entidades.Evidencia> ?? new();}
@if(TempData["Ok"]!=null){<div class="success">@TempData["Ok"]</div>}@if(TempData["Error"]!=null){<div class="alert">@TempData["Error"]</div>}
<div class="content-grid"><section class="panel"><p class="eyebrow">NUEVO REGISTRO</p><h2>Agregar evidencia</h2><form asp-controller="Evidencias" asp-action="Crear" method="post" enctype="multipart/form-data"><input type="hidden" name="categoria" value="@Model"/><div class="field"><label>Nombre o título</label><input name="nombre" required placeholder="Nombre de la evidencia"/></div><div class="field"><label>Descripción</label><textarea name="descripcion" rows="3" placeholder="Detalles adicionales"></textarea></div><div class="field"><label>Institución / asignatura</label><input name="institucion" placeholder="Universidad, empresa o materia"/></div><div class="field"><label>Tipo</label><input name="tipo" placeholder="@((Model=="Academica")?"Preparatoria, TSU o Ingeniería":Model=="Extracurricular"?"Curso, congreso o Semana TI":Model=="Proyecto"?"Proyecto por asignatura":"Certificación, título, carta pasante")"/></div><div class="field"><label>Fecha</label><input type="date" name="fecha"/></div><div class="field"><label>Archivo o imagen</label><input type="file" name="archivo" accept=".pdf,.png,.jpg,.jpeg,.webp"/></div><button class="btn primary">Guardar evidencia</button></form></section><section class="panel"><div class="section-heading"><div><p class="eyebrow">TU HISTORIAL</p><h2>Registros guardados</h2></div><span class="count">@items.Count</span></div>@if(items.Count==0){<div class="empty"><span>▤</span><h3>Aún no hay registros</h3><p>Agrega tu primera evidencia usando el formulario.</p></div>}else{<div class="records">@foreach(var item in items){<article class="record"><div class="record-icon">▤</div><div class="record-info"><h3>@item.Nombre</h3><p>@item.Tipo @if(!string.IsNullOrWhiteSpace(item.Institucion)){<span>· @item.Institucion</span>}</p>@if(item.Fecha.HasValue){<small>@item.Fecha.Value.ToString("dd/MM/yyyy")</small>}@if(!string.IsNullOrWhiteSpace(item.ArchivoRuta)){<p><a href="@item.ArchivoRuta" target="_blank">Ver archivo adjunto ↗</a></p>}</div><form asp-controller="Evidencias" asp-action="Eliminar" method="post" onsubmit="return confirm('¿Eliminar este registro?');"><input type="hidden" name="id" value="@item.EvidenciaId"/><button class="delete" title="Eliminar">×</button></form></article>}}</div>}</section></div>
