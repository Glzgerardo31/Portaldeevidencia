@{ViewData["Title"]="Inicio";}<section class="welcome"><div><p class="eyebrow">PORTAL DE EVIDENCIAS</p><h1>Tu trayectoria,<br/><span>bien organizada.</span></h1><p>Administra tu formación, proyectos y logros académicos desde un solo espacio.</p><a class="btn light" asp-action="Perfil">Completar mi perfil</a></div><div class="welcome-symbol">S</div></section><div class="stats"><a asp-action="FormacionAcademica" class="stat"><span>01</span><strong>@ViewBag.Academica</strong><small>Formación académica</small></a><a asp-action="FormacionExtra" class="stat"><span>02</span><strong>@ViewBag.Extra</strong><small>Formación extracurricular</small></a><a asp-action="Proyectos" class="stat"><span>03</span><strong>@ViewBag.Proyectos</strong><small>Proyectos</small></a><a asp-action="Evidencias" class="stat"><span>04</span><strong>@ViewBag.Total</strong><small>Evidencias totales</small></a></div><section class="quick"><div class="section-heading"><div><p class="eyebrow">NAVEGACIÓN</p><h2>Mis módulos</h2></div></div><div class="module-grid"><a class="module" asp-action="Perfil"><span>♙</span><h3>Perfil</h3><p>Consulta y actualiza tus datos personales.</p><b>Ir al módulo →</b></a><a class="module" asp-action="FormacionAcademica"><span>▤</span><h3>Formación académica</h3><p>Preparatoria, TSU e ingeniería.</p><b>Ir al módulo →</b></a><a class="module" asp-action="FormacionExtra"><span>✦</span><h3>Formación extracurricular</h3><p>Cursos, congresos y eventos.</p><b>Ir al módulo →</b></a><a class="module" asp-action="Proyectos"><span>▧</span><h3>Proyectos</h3><p>Trabajos y evidencias por asignatura.</p><b>Ir al módulo →</b></a><a class="module" asp-action="Evidencias"><span>▣</span><h3>Evidencias detalladas</h3><p>Títulos, certificaciones y documentos.</p><b>Ir al módulo →</b></a></div></section>
