@model Dominio.Entidades.Usuario
@{ViewData["Title"]="Perfil";}<div class="page-title"><p class="eyebrow">MI CUENTA</p><h1>Perfil personal</h1><p>Administra tu información y documentos personales.</p></div>@if(TempData["Ok"]!=null){<div class="success">@TempData["Ok"]</div>}<section class="panel profile-panel"><div class="profile-head"><div class="avatar">@Model.Nombre.Substring(0,1).ToUpper()</div><div><h2>@Model.Nombre</h2><p>@Model.Correo</p></div></div><form asp-action="GuardarPerfil" method="post" enctype="multipart/form-data" class="form-grid"><div class="field"><label>Nombre completo</label><input name="nombre" value="@Model.Nombre" required/></div><div class="field"><label>Teléfono</label><input name="telefono" value="@Model.Telefono"/></div><div class="field"><label>Correo electrónico</label><input type="email" name="correo" value="@Model.Correo" required/></div><div class="field"><label>INE</label><input name="ine" value="@Model.INE"/></div><div class="field"><label>CURP</label><input name="curp" value="@Model.CURP"/></div><div class="field"><label>Acta de nacimiento</label><input type="file" name="actaNacimiento" accept=".pdf,.jpg,.jpeg,.png"/>@if(!string.IsNullOrEmpty(Model.ActaNacimientoRuta)){<a href="@Model.ActaNacimientoRuta" target="_blank">Ver documento actual</a>}</div><div class="form-actions"><button class="btn primary">Guardar cambios</button></div></form></section>
